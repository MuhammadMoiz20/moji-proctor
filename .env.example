# Environment variables for Verified Coursework GitHub Action
# Note: The VS Code extension does not use these variables.
# Copy this file to `.env` and adjust values as needed.

# Choose how to write verified reports
# allowed: firebase | supabase | webhook | disabled
VERIFIED_DB_MODE=disabled

# Firebase configuration (used when VERIFIED_DB_MODE=firebase)
# Firebase project ID from your project settings
FIREBASE_PROJECT_ID=
# Service account client email from your service account JSON
FIREBASE_CLIENT_EMAIL=
# Service account private key from your service account JSON
# IMPORTANT: Preserve the literal \n characters when setting this secret
FIREBASE_PRIVATE_KEY=
# Firestore collection name for storing verified reports (default: verified_reports)
FIREBASE_COLLECTION=verified_reports

# Supabase configuration (used when VERIFIED_DB_MODE=supabase)
# URL of your Supabase project (e.g., https://your-project.supabase.co)
SUPABASE_URL=
# Service role key with insert permissions for the target table
SUPABASE_SERVICE_ROLE_KEY=
# Table name for storing verified reports (default: verified_reports)
SUPABASE_TABLE=verified_reports

# Webhook configuration (used when VERIFIED_DB_MODE=webhook)
# HTTP endpoint to receive verified reports
VERIFIED_WEBHOOK_URL=
# Optional: Bearer token for webhook authorization
VERIFIED_WEBHOOK_BEARER=

# Strict mode for DB writes
# When true, any DB write failure will fail the workflow
STRICT_DB_WRITE=false
