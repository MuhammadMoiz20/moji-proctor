# Moji Proctor Server Environment Variables

# Database
# Neon PostgreSQL connection string format:
# DATABASE_URL="postgresql://username:password@ep-xxxx-xxxx.region.aws.neon.tech/dbname?sslmode=require"
# Get your connection string from: https://console.neon.tech/
DATABASE_URL='postgresql://neondb_owner:npg_V7Pn2oLcSxdg@ep-broad-base-ah2i74fu-pooler.c-3.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require'

# Server
PORT=3000
LOG_LEVEL=info
NODE_ENV="development"

# CORS Configuration
# IMPORTANT: In production, set a specific origin. Wildcard (*) is not allowed with credentials.
# For development with Vite proxy, you can use false or the specific origin
# Since Vite proxies /api requests, CORS is less critical, but set it to the dashboard URL for direct API calls
CORS_ORIGIN="http://localhost:5173"


# JWT Configuration
# IMPORTANT: Must be at least 32 characters for security
JWT_SECRET="your-super-secret-jwt-key-at-least-32-chars-long"

# GitHub OAuth Device Flow
# Get credentials from: https://github.com/settings/developers
GITHUB_CLIENT_ID="Ov23li092z6W8YdghAJ8"
GITHUB_CLIENT_SECRET="1c803028af60d1f0af76cf16f7272b79da50eb71"

# Instructor Authorization
# Comma-separated list of GitHub logins or IDs that should have instructor role
# Example: INSTRUCTOR_ALLOWLIST=professor123,ta456,7890123
INSTRUCTOR_ALLOWLIST="MuhammadMoiz20"

# Security Notes for Production:
# 1. Use strong, unique JWT_SECRET (at least 32 chars)
# 2. Set explicit CORS_ORIGIN (no wildcard)
# 3. Use HTTPS
# 4. Rotate GitHub credentials regularly
# 5. Restrict database access to specific IPs

